# LLM provider settings. Copy to .env and fill in. All three are required.
# Any OpenAI-compatible chat-completions endpoint with tool calling works, e.g.
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
